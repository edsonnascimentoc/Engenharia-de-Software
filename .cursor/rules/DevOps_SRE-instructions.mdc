#### 📝 SEÇÃO DE EXEMPLOS CANÔNICOS (FEW-SHOT EXAMPLES)

```yaml
# [MUST] Snippet Canônico: Manifesto Kubernetes Produtivo com Segurança, Resources e Vault Externo
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payment-processor
  namespace: finance
  labels:
    app.kubernetes.io/name: payment-processor
    app.kubernetes.io/component: microservice
spec:
  replicas: 3
  selector:
    matchLabels:
      app: payment-processor
  template:
    metadata:
      labels:
        app: payment-processor
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        fsGroup: 10001
      containers:
      - name: payment-processor
        image: registry.enterprise.io/finance/payment-processor:v1.2.0
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
        resources:
          requests:
            memory: "256Mi"
            cpu: "200m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        env:
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: external-vault-db-secret
              key: password
        ports:
        - containerPort: 8080
          name: http
```

```hcl
# [MUST] Snippet Canônico: Terraform HCL com Estado Remoto e Boas Práticas
terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  backend "s3" {
    bucket         = "enterprise-terraform-state-prod"
    key            = "sre/k8s-cluster/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "terraform-locks"
    encrypt        = true
  }
}

provider "aws" {
  region = var.aws_region
}
